{
  "name": "sealman-cloudapp-edge-config-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "import-meta-env -x .env.example -e .env.local && vite preview --port 3000",
    "test": "vitest",
    "test:ci": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=cobertura --reporter=default --reporter=junit --outputFile=reports/junit.xml",
    "test:cypress:component:ci": "cross-env NODE_ENV=test npx cypress run --component --reporter junit --reporter-options \"mochaFile=reports/cypress-components-result.xml,toConsole=true\"",
    "combine:reports": "jrm reports/combined-report.xml \"reports/*.xml\"",
    "generate:types": "openapi-typescript http://localhost:5000/openapi.json -o src/generated/edge-administration/types.d.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.30.0",
    "@azure/msal-react": "^3.0.29",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@module-federation/runtime": "2.9.2",
    "@novnc/novnc": "1.5.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.95.0",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.10.1",
    "axios": "^1.15.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "country-locale-map": "^1.9.12",
    "date-fns": "^4.1.0",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.0.1",
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "^0.13.0",
    "openapi-react-query": "^0.2.5",
    "react": "^19.0.0",
    "react-ace": "^14.0.1",
    "react-dom": "^19.2.4",
    "react-json-tree": "^0.20.0",
    "react-leaflet": "^5.0.0",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "^7.13.1",
    "react-select": "^5.10.2",
    "react-toastify": "^11.0.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@import-meta-env/cli": "^0.7.4",
    "@import-meta-env/unplugin": "^0.6.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.95.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "cross-env": "^10.1.0",
    "cypress": "^15.14.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "junit-report-merger": "^9.0.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.9",
    "vitest": "^4.1.5"
  }
}
